<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageId>LinqToFile</PackageId>
        <Description>Query CSV and XLSX with typed C# models and LINQ. Create, append, and insert CSV rows. Select exact date/time formats or custom column converters. Sync/async APIs, BCL-only runtime, source-generated mapping, and Native AOT on .NET 10+.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/dziegelbauer/LinqToFile</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dziegelbauer/LinqToFile.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>linq;csv;xlsx;tabular;streaming;nativeaot;source-generator</PackageTags>
        <PackageReleaseNotes>Prerelease: TemporalFormat annotations select one exact date/time format for CSV/XLSX text reads and CSV writes, using the configured culture. Native XLSX dates retain their existing rules. Complete dates and explicit offsets are validated; selected formats may omit precision. Includes custom converters, LINQ queries, and sync/async CSV creation, append, and insertion. BCL-only runtime and Native AOT support. API changes remain possible.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../LinqToFile.Generator/LinqToFile.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <None Include="../LinqToFile.Generator/bin/$(Configuration)/netstandard2.0/LinqToFile.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
        <None Include="../README.md" Pack="true" PackagePath="/README.md" />
        <None Include="../LICENSE" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
