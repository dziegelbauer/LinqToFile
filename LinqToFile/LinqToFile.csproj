<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageId>LinqToFile</PackageId>
        <Description>Query CSV and XLSX files with typed C# models and standard LINQ. Create, append, and insert CSV rows. Map domain types with custom column converters. Sync/async APIs, BCL-only runtime, source-generated mapping, and Native AOT on .NET 10+.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/dziegelbauer/LinqToFile</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dziegelbauer/LinqToFile.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>linq;csv;xlsx;tabular;streaming;nativeaot;source-generator</PackageTags>
        <PackageReleaseNotes>Prerelease: per-column custom converters for CSV/XLSX reads and CSV writes. Static span-based parsing/formatting supports domain types, nullable values, culture, and native XLSX cell metadata without runtime reflection or converter instances. Includes LINQ queries and sync/async CSV creation, append, and positional insertion. API changes remain possible.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../LinqToFile.Generator/LinqToFile.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <None Include="../LinqToFile.Generator/bin/$(Configuration)/netstandard2.0/LinqToFile.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
        <None Include="../README.md" Pack="true" PackagePath="/README.md" />
        <None Include="../LICENSE" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
